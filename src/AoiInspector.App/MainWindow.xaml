<Window x:Class="AoiInspector.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Surface AOI Inspector" Height="860" Width="1280"
        MinHeight="720" MinWidth="1100" Background="#0B1220">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#DCE6F2"/>
            <Setter Property="FontFamily" Value="Microsoft JhengHei UI"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#2563EB"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="12,9"/>
            <Setter Property="Margin" Value="0,0,0,9"/><Setter Property="FontFamily" Value="Microsoft JhengHei UI"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="#0F172A"/><Setter Property="Background" Value="#EAF0F7"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="9,7"/>
            <Setter Property="Margin" Value="0,4,0,12"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#0F172A"/><Setter Property="Background" Value="#EAF0F7"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="9,7"/>
            <Setter Property="Margin" Value="0,4,0,12"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Surface AOI Inspector" FontSize="28" FontWeight="Bold" Foreground="White"/>
            <TextBlock Text="精密表面檢測工作站 · 配方管理 · 實體尺寸校正 · 批次追溯" FontSize="14" Foreground="#8FA4BE" Margin="0,5,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="310"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#131E2F" CornerRadius="10" Padding="18">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="檢測配方" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
                            <TextBlock Text="配方名稱"/><TextBox x:Name="RecipeNameTextBox"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="載入 JSON" Click="LoadRecipe_Click"/>
                                <Button Grid.Column="2" Content="儲存 JSON" Click="SaveRecipe_Click" Background="#475569"/>
                            </Grid>
                            <Button Content="套用內建起始配方" Click="ApplyBuiltInRecipe_Click" Background="#334155"/>

                            <TextBlock Text="影像輸入" FontWeight="SemiBold" Foreground="#7DD3FC" Margin="0,6,0,9"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="載入影像" Click="LoadImage_Click"/>
                                <Button Grid.Column="2" Content="示範瑕疵" Click="CreateDemo_Click" Background="#475569"/>
                            </Grid>

                            <TextBlock Text="檢測模式"/>
                            <ComboBox x:Name="InspectionModeComboBox" SelectedIndex="3">
                                <ComboBoxItem Content="傳統檢測"/><ComboBoxItem Content="AI 檢測"/>
                                <ComboBoxItem Content="比較模式"/><ComboBoxItem Content="融合判定"/>
                            </ComboBox>
                            <TextBlock Text="融合規則"/>
                            <ComboBox x:Name="HybridRuleComboBox" SelectedIndex="0">
                                <ComboBoxItem Content="任一 NG 即 NG"/><ComboBoxItem Content="AI 主判、分歧複核"/>
                                <ComboBoxItem Content="一致才自動判定"/>
                            </ComboBox>

                            <TextBlock Text="量測與設備設定" FontWeight="SemiBold" Foreground="#FBBF24" Margin="0,4,0,8"/>
                            <TextBlock Text="像素尺寸 (µm/px)"/><TextBox x:Name="MicrometersPerPixelTextBox" Text="5.0"/>
                            <TextBlock Text="相機設定檔"/><TextBox x:Name="CameraProfileTextBox"/>
                            <TextBlock Text="光源設定檔"/><TextBox x:Name="LightingProfileTextBox"/>

                            <TextBlock Text="傳統檢測參數" FontWeight="SemiBold" Foreground="#7DD3FC" Margin="0,4,0,8"/>
                            <TextBlock Text="局部視窗半徑"/><TextBox x:Name="BlurRadiusTextBox"/>
                            <TextBlock Text="差異門檻 (0–255)"/><TextBox x:Name="ThresholdTextBox"/>
                            <TextBlock Text="最小瑕疵面積 (px)"/><TextBox x:Name="MinimumAreaTextBox"/>
                            <TextBlock Text="傳統拒收比例 (%)"/><TextBox x:Name="RejectRatioTextBox"/>

                            <TextBlock Text="AI 檢測參數" FontWeight="SemiBold" Foreground="#5EEAD4" Margin="0,4,0,8"/>
                            <TextBlock Text="像素機率門檻 (0–1)"/><TextBox x:Name="AiProbabilityTextBox"/>
                            <TextBlock Text="AI 拒收比例 (%)"/><TextBox x:Name="AiRejectRatioTextBox"/>
                            <TextBlock x:Name="ModelStatusText" Text="AI 模型：檢查中" FontSize="12" Foreground="#8FA4BE" TextWrapping="Wrap" Margin="0,0,0,10"/>
                        </StackPanel>
                    </ScrollViewer>
                    <Grid Grid.Row="1" Margin="0,12,0,0">
                        <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                        <Button x:Name="InspectButton" Content="單張開始檢測" Click="Inspect_Click" Background="#0EA5A4"/>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition Width="92"/></Grid.ColumnDefinitions>
                            <Button x:Name="BatchButton" Grid.Column="0" Content="資料夾批次" Click="BatchInspect_Click" Background="#2563EB" Margin="0"/>
                            <Button x:Name="CancelButton" Grid.Column="2" Content="停止" Click="Cancel_Click" Background="#B45309" Margin="0" IsEnabled="False"/>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>

            <Grid Grid.Column="2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="#131E2F" CornerRadius="10" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <TextBlock Text="原始影像" FontSize="16" FontWeight="SemiBold" Margin="2,0,0,12"/>
                        <Border Grid.Row="1" Background="#080D16" CornerRadius="6"><Image x:Name="OriginalImage" Stretch="Uniform" Margin="8"/></Border>
                    </Grid>
                </Border>
                <Border Grid.Column="2" Background="#131E2F" CornerRadius="10" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Margin="2,0,0,12">
                            <TextBlock x:Name="MaskTitleText" Text="瑕疵遮罩" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock x:Name="MaskLegendText" FontSize="12" Foreground="#8FA4BE" Margin="12,3,0,0"/>
                        </StackPanel>
                        <Border Grid.Row="1" Background="#080D16" CornerRadius="6"><Image x:Name="MaskImage" Stretch="Uniform" Margin="8"/></Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="#131E2F" CornerRadius="10" Padding="18,14" Margin="0,18,0,0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="165"/><ColumnDefinition Width="*"/><ColumnDefinition Width="285"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Text="尚未檢測" FontSize="22" FontWeight="Bold" Foreground="#8FA4BE" VerticalAlignment="Center"/>
                <TextBlock x:Name="DetailText" Grid.Column="1" Text="請載入影像或使用示範瑕疵" FontSize="14" Foreground="#A8B7CA" VerticalAlignment="Center" TextWrapping="Wrap"/>
                <TextBlock x:Name="TimingText" Grid.Column="2" Text="處理時間：—" FontSize="14" Foreground="#A8B7CA" VerticalAlignment="Center" TextAlignment="Right" TextWrapping="Wrap"/>
            </Grid>
        </Border>
    </Grid>
</Window>
