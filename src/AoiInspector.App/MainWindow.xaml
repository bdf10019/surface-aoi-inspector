<Window x:Class="AoiInspector.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Surface AOI Inspector" Height="820" Width="1220"
        MinHeight="700" MinWidth="1040" Background="#0B1220">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#DCE6F2"/>
            <Setter Property="FontFamily" Value="Microsoft JhengHei UI"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="FontFamily" Value="Microsoft JhengHei UI"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="Background" Value="#EAF0F7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="9,7"/>
            <Setter Property="Margin" Value="0,4,0,13"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="Background" Value="#EAF0F7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="9,7"/>
            <Setter Property="Margin" Value="0,4,0,13"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Surface AOI Inspector" FontSize="28" FontWeight="Bold" Foreground="White"/>
            <TextBlock Text="工業表面瑕疵檢測工作站 · 本機即時判定" FontSize="14" Foreground="#8FA4BE" Margin="0,5,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="270"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#131E2F" CornerRadius="10" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="輸入與參數" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16"/>
                        <Button Content="載入檢測影像" Click="LoadImage_Click"/>
                        <Button Content="建立示範瑕疵" Click="CreateDemo_Click" Background="#475569"/>

                        <TextBlock Text="檢測模式" Margin="0,8,0,0"/>
                        <ComboBox x:Name="InspectionModeComboBox" SelectedIndex="0">
                            <ComboBoxItem Content="傳統檢測"/>
                            <ComboBoxItem Content="AI 檢測"/>
                            <ComboBoxItem Content="比較模式"/>
                        </ComboBox>

                        <TextBlock Text="傳統檢測參數" FontWeight="SemiBold" Foreground="#7DD3FC" Margin="0,4,0,8"/>
                        <TextBlock Text="局部視窗半徑"/>
                        <TextBox x:Name="BlurRadiusTextBox" Text="8"/>
                        <TextBlock Text="差異門檻 (1–255)"/>
                        <TextBox x:Name="ThresholdTextBox" Text="28"/>
                        <TextBlock Text="最小瑕疵面積 (px)"/>
                        <TextBox x:Name="MinimumAreaTextBox" Text="10"/>
                        <TextBlock Text="傳統拒收比例 (%)"/>
                        <TextBox x:Name="RejectRatioTextBox" Text="0.05"/>

                        <TextBlock Text="AI 檢測參數" FontWeight="SemiBold" Foreground="#5EEAD4" Margin="0,4,0,8"/>
                        <TextBlock Text="像素機率門檻 (0–1)"/>
                        <TextBox x:Name="AiProbabilityTextBox" Text="0.5"/>
                        <TextBlock Text="AI 拒收比例 (%)"/>
                        <TextBox x:Name="AiRejectRatioTextBox" Text="0.05"/>
                        <TextBlock x:Name="ModelStatusText" Text="AI 模型：檢查中" FontSize="12" Foreground="#8FA4BE" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    </StackPanel>
                    </ScrollViewer>
                    <Button x:Name="InspectButton" Grid.Row="1" Content="開始檢測" Click="Inspect_Click" Background="#0EA5A4" Margin="0,12,0,0"/>
                </Grid>
            </Border>

            <Grid Grid.Column="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#131E2F" CornerRadius="10" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <TextBlock Text="原始影像" FontSize="16" FontWeight="SemiBold" Margin="2,0,0,12"/>
                        <Border Grid.Row="1" Background="#080D16" CornerRadius="6">
                            <Image x:Name="OriginalImage" Stretch="Uniform" Margin="8"/>
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Background="#131E2F" CornerRadius="10" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Margin="2,0,0,12">
                            <TextBlock x:Name="MaskTitleText" Text="瑕疵遮罩" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock x:Name="MaskLegendText" Text="" FontSize="12" Foreground="#8FA4BE" Margin="12,3,0,0"/>
                        </StackPanel>
                        <Border Grid.Row="1" Background="#080D16" CornerRadius="6">
                            <Image x:Name="MaskImage" Stretch="Uniform" Margin="8"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="#131E2F" CornerRadius="10" Padding="18,14" Margin="0,18,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="165"/><ColumnDefinition Width="*"/><ColumnDefinition Width="250"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Text="尚未檢測" FontSize="22" FontWeight="Bold" Foreground="#8FA4BE" VerticalAlignment="Center"/>
                <TextBlock x:Name="DetailText" Grid.Column="1" Text="請載入影像或使用示範瑕疵" FontSize="14" Foreground="#A8B7CA" VerticalAlignment="Center" TextWrapping="Wrap"/>
                <TextBlock x:Name="TimingText" Grid.Column="2" Text="處理時間：—" FontSize="14" Foreground="#A8B7CA" VerticalAlignment="Center" TextAlignment="Right"/>
            </Grid>
        </Border>
    </Grid>
</Window>
