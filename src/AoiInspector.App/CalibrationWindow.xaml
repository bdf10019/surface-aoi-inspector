<Window x:Class="AoiInspector.App.CalibrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="兩點尺度校正" Height="460" Width="500"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="#0B1220">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#DCE6F2"/>
            <Setter Property="FontFamily" Value="Microsoft JhengHei UI"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="Background" Value="#EAF0F7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,5,0,14"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,11"/>
            <Setter Property="FontFamily" Value="Microsoft JhengHei UI"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <Border Margin="24" Padding="22" Background="#131E2F" CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel>
                <TextBlock Text="兩點尺度校正" FontSize="24" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="以已知實體長度除以影像量測像素，計算 µm/px。" Foreground="#8FA4BE" Margin="0,6,0,18"/>
            </StackPanel>
            <StackPanel Grid.Row="1">
                <TextBlock x:Name="CurrentScaleText" Foreground="#FBBF24" Margin="0,0,0,12"/>
                <TextBlock Text="標定物已知長度 (mm)"/><TextBox x:Name="KnownLengthTextBox" Text="10"/>
                <TextBlock Text="影像量測長度 (px)"/><TextBox x:Name="MeasuredPixelsTextBox" Text="2000"/>
                <TextBlock Text="標定板／量具識別"/><TextBox x:Name="CalibrationReferenceTextBox" Text="DEMO-CALIBRATION"/>
                <TextBlock Text="上線前請以實際鏡頭、工作距離與標定板重複多點驗證。" Foreground="#FCA5A5" TextWrapping="Wrap"/>
            </StackPanel>
            <Grid Grid.Row="2" Margin="0,18,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="取消" Click="Cancel_Click" Background="#475569"/>
                <Button Grid.Column="2" Content="計算並套用" Click="Apply_Click" Background="#0EA5A4"/>
            </Grid>
        </Grid>
    </Border>
</Window>
